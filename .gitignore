vendor/
Godeps/
node_modules/

# Go workspace file
go.work
go.work.sum

# IDE/editor specific files
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Local env / build artifacts
/.env
**/build/
*.db

# Seccomp syscall traces (local profiling)
.seccomp-trace/

# VirtIO runtime pipe dir (created by compose bind-mount)
/run/
