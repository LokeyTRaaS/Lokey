{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "mode": "markdown",
        "content": "Who is calling this node. Each line is one Traefik request: client, method, path, router, and status. Prometheus stays grouped by router so client addresses are not stored as metrics."
      }
    },
    {
      "type": "logs",
      "title": "Recent requests",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 3},
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{job=\"traefik\"} | json | line_format \"{{.client}} {{.method}} {{.path}} router={{.router}} status={{.status}} {{.duration}}ns\"",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by router",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 3,
      "fieldConfig": {
        "defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": true}},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (router) (rate(traefik_router_requests_total[5m]))",
          "legendFormat": "{{router}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "id": 4,
      "fieldConfig": {
        "defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": true}},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (code) (rate(traefik_router_requests_total[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top paths",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "id": 5,
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "spanNulls": true}},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "topk(10, sum by (path) (count_over_time({job=\"traefik\"} | json [5m])))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top clients",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "id": 6,
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "spanNulls": true}},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "topk(10, sum by (client) (count_over_time({job=\"traefik\"} | json [5m])))",
          "legendFormat": "{{client}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 40,
  "tags": ["lokey", "traefik"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "LoKey requests",
  "uid": "lokey-requests"
}
