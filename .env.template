# Traefik host ports (Compose)
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Public hostname used in Traefik / Grafana URLs
LOKEY_DOMAIN=localhost

# Optional ACME email when using Let's Encrypt (leave empty for file/self-signed certs)
# LOKEY_ACME_EMAIL=ops@example.com

# Grafana admin
GRAFANA_USER=admin
GRAFANA_PASSWORD=lokey

# Optional: local registry / build helpers
# DEV_MACHINE_IP=192.168.1.100
# DOCKER_ROOT_DIR=/var/lib/docker
